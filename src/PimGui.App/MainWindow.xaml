<Window x:Class="PimGui.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PyDeck">
 <Grid x:Name="Root" RequestedTheme="Dark">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Padding="20,0,150,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <TextBlock Text="PyDeck" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="/" Opacity="0.35" Margin="8,0"/>
    <TextBlock Text="Python Install Manager" FontSize="15" Opacity="0.65" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Padding="14,20,14,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="14,4,0,32" Spacing="10">
     <Border x:Name="BrandMark" Width="44" Height="44" CornerRadius="14" HorizontalAlignment="Left">
      <Image Source="Assets/AppIcon.png" AutomationProperties.Name="PyDeck"/>
     </Border>
     <TextBlock Text="A home for Python." FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
     <TextBlock Text="Your versions, in one place." FontSize="11" Opacity="0.6"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="6" x:Name="NavPanel">
     <Button x:Name="RuntimesNav" Tag="runtimes" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8F1;" FontSize="18"/><TextBlock Text="My Python" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="CatalogNav" Tag="catalog" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE896;" FontSize="18"/><TextBlock Text="Install Python" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="EnvironmentsNav" Tag="environments" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="18"/><TextBlock Text="Virtual environments" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="ActivityNav" Tag="activity" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9D9;" FontSize="18"/><TextBlock Text="Activity" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="16">
     <Button x:Name="SettingsNav" Tag="settings" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="18"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
     <Border x:Name="ConnectionCard" Padding="14" CornerRadius="14">
      <StackPanel Spacing="7">
       <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="ConnectionDot" Width="6" Height="6"/><TextBlock x:Name="ConnectionText" Text="Connecting…" FontSize="12" FontWeight="SemiBold"/></StackPanel>
       <TextBlock Text="Powered by Python Install Manager" FontSize="10" Opacity="0.55" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
   <Border Grid.Column="1" x:Name="PageSurface" Margin="0,6,14,0" CornerRadius="24" Padding="30,26,30,22">
    <Grid x:Name="ContentColumn" MaxWidth="1160">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <InfoBar x:Name="MessageBar" Grid.Row="0" IsOpen="False" IsClosable="True" Margin="0,0,0,14"/>
     <StackPanel Grid.Row="1" Spacing="10">
      <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,14"/>
      <Border x:Name="OperationPanel" Visibility="Collapsed" Padding="16" Margin="0,0,0,16" CornerRadius="8">
       <Grid RowSpacing="8" ColumnSpacing="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
         <TextBlock x:Name="OperationTitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         <TextBlock x:Name="OperationPhaseText" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Button x:Name="CancelOperationButton" Grid.Column="1" Content="Cancel" VerticalAlignment="Center" Click="CancelOperation_Click"/>
        <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True" Minimum="0" Maximum="100"/>
       </Grid>
      </Border>
     </StackPanel>
     <Grid Grid.Row="2" x:Name="PageHost"/>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Padding="26,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <TextBlock x:Name="StatusText" Text="Connecting to Python Install Manager…" FontSize="11" Opacity="0.65" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
    <Button x:Name="RefreshDatabaseButton" Click="RefreshDatabase_Click" Padding="8,2" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE72C;" FontSize="12"/><TextBlock Text="Refresh database" FontSize="11"/></StackPanel></Button>
   </StackPanel>
   <TextBlock x:Name="StyleStatus" Text="PyDeck" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Opacity="0.5"/>
  </Grid>
 </Grid>
</Window>
