<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <Package Name="PyDeck" Manufacturer="DM10cn" Version="$(var.ProductVersion)" Language="1033"
           UpgradeCode="D43AFAF7-DFE0-4AC1-A0A3-8F73AD6F89CA" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of PyDeck is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="PyDeckIcon" SourceFile="$(var.PayloadDir)\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="PyDeckIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/DM10cn/PyDeck" />
    <Property Id="ARPHELPLINK" Value="https://github.com/DM10cn/PyDeck/issues" />
    <Property Id="WINDOWSBUILD">
      <RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <netfx:DotNetCompatibilityCheck Id="Net10" Property="DOTNET10CHECK" RuntimeType="core" Platform="x64" Version="10.0.0" RollForward="latestPatch" />
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 22000)" Message="PyDeck requires Windows 11 x64." />
    <Launch Condition="Installed OR DOTNET10CHECK = &quot;0&quot;" Message="Install .NET Runtime 10 (x64) before installing PyDeck: https://dotnet.microsoft.com/download/dotnet/10.0" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LOCALPROGRAMS" Name="Programs"><Directory Id="INSTALLFOLDER" Name="PyDeck" /></Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="APPSTARTMENU" Name="PyDeck" /></StandardDirectory>
    <DirectoryRef Id="APPSTARTMENU">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="LaunchPyDeck" Name="PyDeck" Target="[INSTALLFOLDER]PyDeck.exe" WorkingDirectory="INSTALLFOLDER" Icon="PyDeckIcon" />
        <RemoveFolder Id="RemoveStartMenu" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveEmptyPrograms" Directory="LOCALPROGRAMS" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\DM10cn\PyDeck\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="Application" Title="PyDeck" Level="1">
      <ComponentGroupRef Id="PayloadFiles" /><ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>
