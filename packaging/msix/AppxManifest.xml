<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop6 rescap">
  <Identity Name="DM10cn.PyDeck" Publisher="CN=DM10cn" Version="0.4.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>PyDeck</DisplayName>
    <PublisherDisplayName>DM10cn</PublisherDisplayName>
    <Description>A desktop companion for Python Install Manager</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- PIM configuration, interpreter installs and the cross-instance lock must stay visible outside this package. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>
  <Resources><Resource Language="en-US" /><Resource Language="zh-CN" /><Resource Language="zh-TW" /><Resource Language="ja-JP" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" MinVersion="2.5.1.0" />
  </Dependencies>
  <Applications>
    <Application Id="App" Executable="PyDeck.exe" EntryPoint="Windows.FullTrustApplication"
                 uap10:RuntimeBehavior="packagedClassicApp" uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="PyDeck" Description="A desktop companion for Python Install Manager"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust" /><rescap:Capability Name="unvirtualizedResources" /></Capabilities>
</Package>
